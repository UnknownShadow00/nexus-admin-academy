DATABASE_URL=sqlite:///./nexus.db
APP_ENV=development
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

ADMIN_USERNAME=change_this_admin_username
ADMIN_PASSWORD=change_this_admin_password
ADMIN_API_KEY=change_this_separate_api_key
# Legacy fallback for ADMIN_PASSWORD/ADMIN_API_KEY (still read by admin_auth.py)
ADMIN_SECRET_KEY=change_this_random_string

# Comma-separated. FRONTEND_URL is read as a fallback if CORS_ORIGINS is unset.
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=/var/www/uploads/screenshots
APP_LOG_PATH=/var/log/nexus/app.log
# Production/staging default to secure cookies when APP_ENV is set accordingly.
# Keep this false only for local HTTP development; omit it in HTTPS production.
COOKIE_SECURE=false

# Nexus V2 student curriculum is development-only until explicitly enabled.
V2_CURRICULUM_ENABLED=false

# Seed account passwords — scripts/seed_users.py refuses to run unless all seven are set
SEED_PASSWORD_MENTOR=
SEED_PASSWORD_SHAK=
SEED_PASSWORD_RAKIB=
SEED_PASSWORD_AHMED=
SEED_PASSWORD_EMRAN=
SEED_PASSWORD_WALO=
SEED_PASSWORD_HUDAYFA=

# AI — local Ollama (OpenAI-compatible endpoint). App uses content only, not reasoning traces.
AI_BASE_URL=http://<ollama-host>:11434/v1
AI_MODEL=deepseek-r1:32b
AI_ENABLED=true
MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.6

# AI grading (Phase 1C) — local rubric-based grading of ambiguous free-response
# / Explain answers ONLY. Deterministic grading always runs first. When
# disabled or unset, ambiguous answers queue for mentor review; nothing breaks.
# URL/MODEL/API_KEY fall back to the AI_* vars above when unset.
AI_GRADING_ENABLED=false
AI_GRADING_URL=
AI_GRADING_MODEL=
AI_GRADING_API_KEY=
AI_GRADING_ENDPOINT_LABEL=local-ai
AI_GRADING_TIMEOUT=45
AI_GRADING_MAX_RETRIES=5
AI_GRADING_CONFIDENCE_THRESHOLD=0.7
AI_GRADING_BACKOFF_BASE_SECONDS=60
AI_GRADING_BACKOFF_MAX_SECONDS=3600

# Discord milestone notifications (optional)
DISCORD_WEBHOOK_URL=

# Proxmox — VM-backed labs
PROXMOX_HOST=
PROXMOX_TOKEN_ID=apiuser@pve!tokenname
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=pve
VMID_POOL_START=200
VMID_POOL_END=299
PROXMOX_VERIFY_SSL=true
# false requests linked clones and safely falls back to full clones when the template storage is unsupported
PROXMOX_FULL_CLONE=false
LAB_VM_TTL_MINUTES=120

# Guacamole 1.6.0 — VM-backed labs. The backend creates temporary, connection-scoped users.
GUACAMOLE_URL=
GUACAMOLE_ADMIN_USERNAME=guacadmin
GUACAMOLE_ADMIN_PASSWORD=
# Guacamole datasource for REST/client URLs — defaults to postgresql (use "mysql" for MySQL-backed Guacamole)
GUACAMOLE_DATASOURCE=postgresql
