DATABASE_URL=sqlite:///./nexus.db
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

ADMIN_USERNAME=change_this_admin_username
ADMIN_PASSWORD=change_this_admin_password
ADMIN_API_KEY=change_this_separate_api_key
# Legacy fallback for ADMIN_PASSWORD/ADMIN_API_KEY (still read by admin_auth.py)
ADMIN_SECRET_KEY=change_this_random_string

# Comma-separated. FRONTEND_URL is read as a fallback if CORS_ORIGINS is unset.
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=/var/www/uploads/screenshots
APP_LOG_PATH=/var/log/nexus/app.log
COOKIE_SECURE=false

# Seed account passwords — scripts/seed_users.py refuses to run unless all seven are set
SEED_PASSWORD_MENTOR=
SEED_PASSWORD_SHAK=
SEED_PASSWORD_RAKIB=
SEED_PASSWORD_AHMED=
SEED_PASSWORD_EMRAN=
SEED_PASSWORD_WALO=
SEED_PASSWORD_HUDAYFA=

# AI — local Ollama (OpenAI-compatible endpoint). App uses content only, not reasoning traces.
AI_BASE_URL=http://192.168.0.104:11434/v1
AI_MODEL=deepseek-r1:32b
AI_ENABLED=true
MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=30
AI_TEMPERATURE=0.6

# Discord milestone notifications (optional)
DISCORD_WEBHOOK_URL=

# Proxmox — VM-backed labs
PROXMOX_HOST=
PROXMOX_TOKEN_ID=apiuser@pve!tokenname
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=pve
VMID_POOL_START=200
VMID_POOL_END=299
PROXMOX_VERIFY_SSL=true

# Guacamole — VM-backed labs
GUACAMOLE_URL=
GUACAMOLE_ADMIN_USER=guacadmin
GUACAMOLE_ADMIN_PASS=
# Guacamole datasource for REST/client URLs — defaults to postgresql (use "mysql" for MySQL-backed Guacamole)
GUACAMOLE_DATASOURCE=postgresql
