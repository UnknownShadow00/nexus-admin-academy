# Backend API base URL
VITE_API_URL=http://localhost:8000

# Browser monitoring is disabled when this public DSN is unset.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Set by CI/deployment to the git SHA or immutable build version.
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.10
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Build/CI only (never VITE_-prefixed and never included in browser JavaScript):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
