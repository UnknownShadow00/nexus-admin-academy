{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXUS_INTEGRATION",
    "NEXT_PUBLIC_BASE_PATH",
    "NEXT_PUBLIC_NEXUS_INTEGRATION",
    "SERVICE_DESK_BASE_PATH"
  ],
  "globalPassThroughEnv": [
    "JWT_ALGORITHM",
    "JWT_SECRET_KEY",
    "NEXUS_ADMIN_CHECK_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
