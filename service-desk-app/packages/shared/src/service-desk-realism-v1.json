        {
          "output": [
            "Access denied. Server reachable; share exists."
          ],
          "evidence": "share-denied",
          "when": {
            "directory/sessionAccess": false
          },
          "set": {},
          "effect": "observe"
        },
        {
          "output": [
            "Share opens: Campaigns, Brand, Onboarding."
          ],
          "when": {
            "directory/sessionAccess": true,
            "directory/broadGranted": true
          },
          "set": {},
          "effect": "observe"
        },
        {
          "output": [
            "Access denied. Server reachable; share exists."
          ],
          "evidence": "share-denied",
          "when": {
            "realism/repaired": false
          },
          "set": {},
          "effect": "observe"
        },
        {
