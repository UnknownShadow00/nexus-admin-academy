          "effect": "observe"
        }
      ],
      "ping 10.26.19.80": [
        {
          "output": [
            "Request timed out."
          ],
          "evidence": "old-address",
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ],
      "ping 10.26.19.94": [
        {
          "output": [
            "Reply from {printer/currentAddress}: bytes=32 time=4ms"
          ],
          "evidence": "current-address",
          "when": {
            "realism/observed/port": true,
            "realism/observed/asset": true,
            "realism/observed/spooler": true
          },
          "set": {},
          "effect": "observe"
        },
        {
          "output": [
            "Reply from {printer/currentAddress}: bytes=32 time=4ms"
          ],
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ],
