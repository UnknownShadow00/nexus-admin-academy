        {
          "output": [
            "Name: {printer/name}",
            "Driver: {printer/driver}",
            "Queued jobs: {printer/queue}"
          ],
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ],
      "sc query \"Print Spooler\"": [
        {
