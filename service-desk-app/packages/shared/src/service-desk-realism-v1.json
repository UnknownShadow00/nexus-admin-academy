  "INC2504": {
    "assetTag": "NX-2504",
    "id": "printer-dhcp-port",
    "title": "My drawing packets are not printing",
    "issue": "Printing worked yesterday, but today everything I send just sits there. I made a copy at the copier and that worked. I need the drawings for our review this afternoon.",
    "hints": [
      "Separate a printer problem from a problem with this computer's print connection.",
      "Inspect the Windows print service, local port settings and the printer's asset record. Test the addresses you find.",
      "Compare the configured destination with the reachable printer address; retest printing after any change."
    ],
    "initial": {
      "printer": {
        "name": "ENG-COPIER",
        "currentAddress": "10.26.19.94",
        "portTarget": "10.26.19.80",
        "online": true,
        "queue": 2,
        "completed": 0,
        "driver": "Nexus Universal PCL6"
      },
      "services": {
        "Print Spooler": {
          "name": "Print Spooler",
          "displayName": "Print Spooler",
          "state": "running",
          "startupType": "automatic",
          "dependencies": []
        }
      },
      "realism": {
        "observed": {},
        "changed": false,
        "repaired": false,
        "harmful": false,
        "lastEvidence": null
      },
      "machine": {
        "signedInUser": "NEXUS\\sofia.nguyen",
        "profileState": "normal"
      },
      "filesystem": {
        "nodes": {}
      }
    },
    "categories": {
      "investigation": [
        "spooler",
