        {
          "output": [
            "Job remains queued; printer did not acknowledge the page."
          ],
          "when": {},
          "set": {
            "printer/queue": 3
          },
          "effect": "ineffective"
        }
      ],
      "help": [
        {
          "output": [
            "Simulated support shell. Commands are scoped to this assigned workstation.",
