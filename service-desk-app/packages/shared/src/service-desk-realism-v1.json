            "sc query \"Print Spooler\"",
            "Get-PrinterPort -Name ENG-COPIER",
            "Get-Asset -Name ENG-COPIER",
            "ping 10.26.19.80",
            "ping 10.26.19.94",
            "Restart-Service -Name Spooler",
            "Set-PrinterPort -Name ENG-COPIER -PrinterHostAddress 10.26.19.94",
            "Set-PrinterPort -Name ENG-COPIER -PrinterHostAddress 10.26.19.80",
            "Print-TestPage -Name ENG-COPIER",
            "whoami",
            "Stop-Service -Name Spooler",
            "Start-Service -Name Spooler"
          ],
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ],
      "whoami": [
        {
          "output": [
            "{machine/signedInUser}"
          ],
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ],
      "Stop-Service -Name Spooler": [
        {
          "output": [
            "Print Spooler: {services/Print Spooler/state}"
          ],
          "when": {},
          "set": {
            "services/Print Spooler/state": "stopped"
          },
          "effect": "ineffective"
        }
      ],
      "Start-Service -Name Spooler": [
        {
          "output": [
            "Print Spooler: {services/Print Spooler/state}"
          ],
          "when": {},
          "set": {
            "services/Print Spooler/state": "running"
          },
          "effect": "ineffective"
        }
      ]
    },
    "completion": {
      "rootCause": "The local TCP/IP port retained 10.26.19.80 while the online printer was at 10.26.19.94.",
      "whatFixed": "Updated the local port to 10.26.19.94 and produced a completed test page with an empty queue.",
      "whyItWorked": "The spooler and driver were available. Restarting the spooler could not change the destination. No server repair or escalation was needed."
    },
    "noteFacts": [
      [
        "10.26.19.80"
      ],
      [
        "10.26.19.94"
      ],
      [
        "port"
      ],
      [
        "test",
        "page"
      ]
    ],
    "finalConditions": {
      "printer/portTarget": "10.26.19.94",
      "printer/queue": 0,
      "services/Print Spooler/state": "running"
    }
