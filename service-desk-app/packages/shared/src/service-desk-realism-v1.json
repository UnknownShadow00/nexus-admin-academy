            "New session created."
          ],
          "when": {
            "realism/repaired": true
          },
          "set": {
            "directory/sessionAccess": true
          },
          "effect": "observe"
        },
        {
          "output": [
            "New session created."
          ],
          "when": {},
          "set": {
            "directory/sessionAccess": false
          },
          "effect": "observe"
        }
      ],
      "help": [
        {
          "output": [
            "Simulated support shell. Commands are scoped to this assigned workstation.",
            "Test-Path \\\\files.nexus.internal\\Marketing",
            "Get-ADPrincipalGroupMembership taylor.reed",
            "Get-ADPrincipalGroupMembership jamie.chen",
            "Get-AccessApproval -User taylor.reed",
            "Get-ADGroup Marketing-Share-RW",
            "Add-ADGroupMember -Identity Marketing-Share-RW -Members taylor.reed",
            "Add-ADGroupMember -Identity All-Departments-RW -Members taylor.reed",
            "Start-UserSession taylor.reed",
            "whoami"
          ],
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ],
      "whoami": [
        {
          "output": [
            "{machine/signedInUser}"
          ],
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ]
    },
    "completion": {
      "rootCause": "The share was reachable, but Taylor lacked the approved Marketing-Share-RW group.",
      "whatFixed": "Reviewed the recorded approval, compared an authorized peer, applied only Marketing-Share-RW and tested a fresh session.",
      "whyItWorked": "Access denied distinguished authorization from routing or a missing path. All-Departments-RW can open the share but violates least privilege; technical access alone is not a professional success."
    },
    "noteFacts": [
      [
        "marketing"
      ],
      [
        "marketing-share-rw"
      ],
      [
        "group",
        "membership"
      ],
      [
        "access",
        "open"
      ]
    ],
    "finalConditions": {
      "directory/requesterGroups": [
        "Domain Users",
        "Marketing-Share-RW"
      ],
      "directory/sessionAccess": true
    }
