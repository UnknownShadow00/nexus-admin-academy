  "INC2505": {
    "assetTag": "NX-2505",
    "id": "department-share-least-privilege",
    "title": "I cannot open the team folder",
    "issue": "It's my first week and the Marketing folder from the welcome email won't open. Email works. Am I using the wrong link? I need the campaign files before onboarding tomorrow.",
    "hints": [
      "Work out whether the resource is missing, unreachable or refusing this user's access.",
      "Compare the requester with an authorized colleague and read the access approval before changing memberships.",
      "Use only the group approved for this resource, then test using a fresh requester session."
    ],
