            "Print Spooler: {services/Print Spooler/state}"
          ],
          "evidence": "spooler",
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ],
      "Get-PrinterPort -Name ENG-COPIER": [
        {
          "output": [
            "Port target: {printer/portTarget}"
          ],
          "evidence": "port",
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ],
      "Get-Asset -Name ENG-COPIER": [
        {
          "output": [
            "Current address: {printer/currentAddress}",
            "Online: {printer/online}",
            "Connection: direct TCP/IP; no shared print server"
          ],
          "evidence": "asset",
          "when": {},
