            "Share opens: Campaigns, Brand, Onboarding."
          ],
          "evidence": "share-open",
          "when": {
            "directory/sessionAccess": true,
            "realism/repaired": true
          },
          "set": {},
          "effect": "observe"
        },
        {
          "output": [
            "Access denied. Start a fresh requester session."
          ],
          "when": {},
          "set": {},
          "effect": "observe"
        }
      ],
      "Get-ADPrincipalGroupMembership taylor.reed": [
        {
          "output": [
            "taylor.reed: {directory/requesterGroups}"
          ],
          "evidence": "requester-groups",
