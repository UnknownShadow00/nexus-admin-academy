# Leave disabled for standalone/local/CI mode.
NEXUS_INTEGRATION=0
# Compose mirrors NEXUS_INTEGRATION into this build-time client flag.
NEXT_PUBLIC_NEXUS_INTEGRATION=0

# Shared Nexus student-session JWT verification settings.
JWT_SECRET_KEY=replace-with-the-nexus-jwt-secret
JWT_ALGORITHM=HS256

# Nexus backend origin used for the opaque platform-admin cookie check.
NEXUS_ADMIN_CHECK_URL=http://nexus-backend:8000

# Build-time mount path; NEXT_PUBLIC_BASE_PATH mirrors this value for clients.
SERVICE_DESK_BASE_PATH=/service-desk
NEXT_PUBLIC_BASE_PATH=/service-desk

# Reserved for the future database-backed phase. The current app does not read
# these values, but the deferred postgres service in docker/docker-compose.yml
# uses them when that service is started.
POSTGRES_DB=service_desk
POSTGRES_USER=service_desk
POSTGRES_PASSWORD=replace-with-a-local-development-password
